<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>¡Lanza los dados!</title>
  <style>
    body {
      font-family: sans-serif;
      text-align: center;
      padding-top: 50px;
      background: #f1f1f1;
    }
    .dice-container {
      display: flex;
      justify-content: center;
      gap: 40px;
      margin-top: 30px;
    }
    .die {
      width: 100px;
      height: 100px;
      font-size: 36px;
      font-weight: bold;
      color: white;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
    }
    .rojo {
      background-color: #e63946;
    }
    .verde {
      background-color: #2a9d8f;
    }
    button {
      padding: 10px 20px;
      font-size: 18px;
      background-color: #264653;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    button:hover {
      background-color: #1d3557;
    }
  </style>
</head>
<body>

  <h1>¡Lanza los dados!</h1>
  <button onclick="tirarDados()">Tirar</button>

  <div class="dice-container">
    <div class="die rojo" id="dadoNegativo">🎲</div>
    <div class="die verde" id="dadoPositivo">🎲</div>
  </div>

  <script>
    function numeroNegativoAleatorio() {
      return -Math.floor(Math.random() * 6 + 1); // -1 a -6
    }

    function numeroPositivoAleatorio() {
      return Math.floor(Math.random() * 6 + 1); // 1 a 6
    }

    function tirarDados() {
      const negativo = numeroNegativoAleatorio();
      const positivo = numeroPositivoAleatorio();

      document.getElementById("dadoNegativo").textContent = negativo;
      document.getElementById("dadoPositivo").textContent = positivo;
    }
  </script>

</body>
</html>
